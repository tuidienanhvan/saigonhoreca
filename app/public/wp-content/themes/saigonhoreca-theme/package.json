{
  "name": "saigonhoreca-theme",
  "version": "1.0.0",
  "description": "Saigon Horeca WordPress Theme — bếp công nghiệp & quầy bar. Tailwind v4, per-route bundles, static HTML cache, image-LCP. Forked từ saigonhoreca-theme.",
  "main": "index.php",
  "scripts": {
    "dev": "tailwindcss -i ./assets/css/style.css -o ./assets/css/dist/theme.css --watch",
    "dev:home": "tailwindcss -i ./assets/css/entrypoints/style-home.css -o ./assets/css/dist/theme-home.css --watch",
    "build": "node scripts/build.mjs",
    "build:force": "node scripts/build.mjs --force",
    "build:strict": "node scripts/build.mjs --strict-anim",
    "lint": "node scripts/build.mjs --lint-only",
    "perf": "lhci autorun",
    "perf:all": "node scripts/perf-sweep.mjs",
    "deploy:package": "node scripts/package-deploy.mjs"
  },
  "keywords": [
    "wordpress",
    "theme",
    "horeca",
    "tailwindcss"
  ],
  "author": "Saigon Horeca",
  "license": "ISC",
  "dependencies": {
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/cli": "^4.0.0",
    "chrome-launcher": "^1.2.1",
    "esbuild": "^0.28.1",
    "lighthouse": "^12.8.2"
  }
}
