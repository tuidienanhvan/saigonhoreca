{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "color": {
            "palette": [
                { "slug": "primary", "color": "#0a0a0a", "name": "Primary (Black)" },
                { "slug": "primary-dark", "color": "#000000", "name": "Primary Dark" },
                { "slug": "primary-light", "color": "#1a1a1a", "name": "Primary Light" },
                { "slug": "secondary", "color": "#f5a623", "name": "Secondary (Gold)" },
                { "slug": "secondary-dark", "color": "#b9821f", "name": "Secondary Dark" },
                { "slug": "accent", "color": "#f5a623", "name": "Accent (Gold)" },
                { "slug": "accent-dark", "color": "#b9821f", "name": "Accent Dark" },
                { "slug": "success", "color": "#16a34a", "name": "Success" },
                { "slug": "warning", "color": "#d97706", "name": "Warning" },
                { "slug": "danger", "color": "#dc2626", "name": "Danger" },
                { "slug": "info", "color": "#2563eb", "name": "Info" }
            ],
            "custom": true,
            "defaultPalette": false
        },
        "typography": {
            "fluid": true
        },
        "spacing": {
            "padding": true,
            "margin": true
        }
    }
}
